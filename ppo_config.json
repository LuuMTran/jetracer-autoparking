{
  "schema_version": 1,
  "seed": 7,
  "physical_rollout_enabled": true,
  "reward_mode": "human_terminal",
  "action_scale": {
    "steering": 0.9,
    "throttle": 0.8
  },
  "algorithm": {
    "gamma": 0.99,
    "gae_lambda": 0.95,
    "clip_ratio": 0.2,
    "value_weight": 0.5,
    "entropy_weight": 0.001,
    "initial_exploration_std": 0.08,
    "minimum_exploration_std": 0.02,
    "maximum_exploration_std": 0.30,
    "initial_actor_logit_gain": {
      "steering": 1.15,
      "throttle": 3.0
    },
    "learning_rate": 0.00003,
    "update_epochs": 4,
    "sequence_length": 16,
    "sequences_per_batch": 8,
    "max_grad_norm": 1.0,
    "train_projection": false,
    "train_gru": false
  },
  "reward": {
    "weights": {
      "step_penalty": 0.002
    }
  },
  "rollout": {
    "control_hz": 10,
    "maximum_episode_steps": 400,
    "minimum_episodes_per_update": 5,
    "pose_max_age_s": 0.2
  }
}
